#!/usr/bin/env bash
# The single endpoint for the harness tools.
#   run <tool> args…     runs the project's tools/<tool> if there is one, else the home's
#   run doc <platform>   the index: one line per tool tagged for claude or opencode, project first
#   run doc <tool>       the tool's help
# A tool documents itself --help style in the comment block right under its shebang;
# the block ends at the first line that is not a comment:
#   # platforms: claude opencode
#   # Usage: TOOL FORM...
#   #        TOOL OTHER FORM...
#   # One line on what it does: the index line.
#   #   details, indented
set -euo pipefail
home=$(cd "$(dirname "$0")" && pwd)
project=$(git rev-parse --show-toplevel 2>/dev/null || pwd)/tools
[ "$project" = "$home" ] && project=

locate() { for d in $project $home; do [ -x "$d/$1" ] && { echo "$d/$1"; return; }; done; return 1; }
page() { awk '/^# platforms:/{on=1;next} on&&/^#/{sub(/^# ?/,"");print;next} on{exit}' "$1"; }
index() {
  case $1 in
    claude)   r="${home/#$HOME/\~}/run"; printf 'Usage: %s TOOL [ARG]...   the project'"'"'s tools/TOOL first, else the home'"'"'s\n       %s doc TOOL        the tool'"'"'s help\n' "$r" "$r" ;;
    opencode) printf 'Usage: run tool, name + args   the project'"'"'s tools/NAME first, else the home'"'"'s\n       run doc NAME            the tool'"'"'s help\n' ;;
  esac
  for d in $project $home; do
    for f in "$d"/*; do
      [ -f "$f" ] && [ -x "$f" ] && grep -q "^# platforms: .*\b$1\b" "$f" || continue
      printf '  %-15s %s\n' "$(basename "$f")" "$(page "$f" | awk '!/^Usage:/ && !/^[[:space:]]/ && NF {print; exit}')"
    done
  done
}

[ $# -gt 0 ] || { sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
cmd=$1; shift
if [ "$cmd" = doc ]; then
  case ${1:-} in
    claude|opencode) index "$1" ;;
    "") echo "run doc: a platform, claude or opencode, or a tool" >&2; exit 2 ;;
    *) f=$(locate "$1") || { echo "run doc: no tool $1" >&2; exit 1; }; page "$f" ;;
  esac
  exit
fi
f=$(locate "$cmd") || { echo "run: no tool $cmd" >&2; exit 1; }
exec "$f" "$@"
