{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mechasuit",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "mechasuit": {
      "description": "Collaborative mecha suit: the user navigates, the agent drives.",
      "mode": "primary",
      "prompt": "{file:./prompts/system.md}\n\n{file:./prompts/doctrine.md}\n\n{file:./prompts/mecha-suit.md}"
    },
    "robot": {
      "description": "Autonomous execution with the Groveling Worm voice.",
      "mode": "primary",
      "prompt": "{file:./prompts/system.md}\n\n{file:./prompts/doctrine.md}\n\n{file:./prompts/autopilot.md}\n\n{file:./prompts/groveling-worm.md}"
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md",
    "~/.config/opencode/tools/docs/opencode.md"
  ]
}
