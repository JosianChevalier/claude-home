{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "180000"
  },
  "permissions": {
    "allow": [
      "Bash(~/.claude/tools/run *)",
      "Bash(cd ~/.claude && git *)",
      "Bash(git -C ~/.claude *)",
      "Edit(~/.claude/**)",
      "Read(~/.claude/**)",
      "Edit(//private/tmp/claude/**)",
      "Read(//private/tmp/claude/**)",
      "Edit(//tmp/claude/**)",
      "Read(//tmp/claude/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "high",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/widgets/statusline.py"
  },
  "autoMemoryEnabled": false,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "enableArtifact": false,
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": false,
  "feedbackDrafts": "quiet",
  "editorMode": "normal",
  "theme": "auto",
  "tui": "fullscreen",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tools/run doc claude"
          }
        ]
      }
    ]
  }
}
