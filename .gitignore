# Whitelist strategy: ignore everything, then re-include only what we version.
# ~/.claude is full of state & secrets (history, sessions, telemetry, auth) —
# nothing is tracked unless explicitly listed below.

# 1. Ignore everything by default.
*

# 2. Re-include the files/dirs we version (parents must be un-ignored to reach files).
!/.gitignore
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/*.work.md

!/philosophy/
!/philosophy/**
!/rules/
!/rules/*.md
!/agents/
!/agents/*.md
!/commands/
!/commands/*.md
!/tools/
!/tools/README.md
!/tools/replace-text
!/tools/grab-notebook

# Migration backlog: tracked until old-claude/ is empty (sync-repo.work.md), then the rule goes.
!/old-claude/
!/old-claude/**
!/settings.template.json
!/opencode.json

!/widgets/
!/widgets/*.py
!/widgets/*.md
!/widgets/quota/
!/widgets/quota/*.py
!/widgets/quota/*.md
!/widgets/quota/macos/
!/widgets/quota/macos/*.py
!/widgets/quota/macos/plugin/
!/widgets/quota/macos/plugin/*.py
!/widgets/quota/windows/
!/widgets/quota/windows/*.py
!/widgets/quota/tests/
!/widgets/quota/tests/*.py

!/skills/
!/skills/*/
!/skills/*/SKILL.md
!/skills/*/**/*.md
!/skills/*/scripts/
!/skills/*/scripts/*.sh

# 3. Belt-and-suspenders: never track caches even if a rule above is loosened.
__pycache__/
*.pyc
.usage-cache.json
.statusline-snapshot.json
*.tmp
